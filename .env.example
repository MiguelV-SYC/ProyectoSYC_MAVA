# Plantilla de variables para podman-compose.yml.
#
# Copia este archivo como ".env" (sin ".example") en la misma
# carpeta, y completa los valores reales para TU máquina.
# El archivo ".env" nunca se sube a git (está en .gitignore) —
# cada máquina (oficina, casa) tiene el suyo con sus propios
# valores.

# --- Proxy corporativo (solo necesario en la oficina SYC) ---
# En casa, deja estas 3 líneas vacías: sin proxy corporativo,
# el build y el backend funcionan igual.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# --- Base de datos ---
DB_USER=
DB_PASSWORD=
DB_NAME=sgds_db

# --- JWT (autenticación) ---
# Importante: debe ser el MISMO valor de Jwt:Key que ya usa el
# proyecto (appsettings.json), o los usuarios con sesión activa
# perderán su token al reiniciar el backend.
JWT_KEY=
JWT_ISSUER=SGDS.Api
JWT_AUDIENCE=SGDS.Frontend
JWT_EXPIRES_MINUTES=60

# --- reCAPTCHA ---
# La clave SECRETA del servidor (Recaptcha:SecretKey), no la
# clave pública que usa el frontend.
RECAPTCHA_SECRET_KEY=
